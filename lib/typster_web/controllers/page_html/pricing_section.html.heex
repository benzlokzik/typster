<section id="pricing" class="mk-section">
  <div class="mk-container">
    <p class="mk-eyebrow mk-reveal">{gettext("landing.pricing.eyebrow")}</p>
    <h2 class="mk-section-h mk-reveal">{gettext("landing.pricing.h")}</h2>
    <p class="mk-section-sub mk-reveal">
      {gettext("landing.pricing.sub")}
    </p>
    <div class="mk-price-grid mk-reveal-group">
      <div class="mk-price">
        <p class="mk-price-name">{gettext("landing.pricing.free.name")}</p>
        <p class="mk-price-desc">{gettext("landing.pricing.free.desc")}</p>
        <div class="mk-price-amt">$0 <small>{gettext("landing.pricing.free.period")}</small></div>
        <.link
          navigate={~p"/users/register"}
          class="mk-btn mk-btn-outline"
          style="width:100%;justify-content:center;margin-top:18px"
        >
          {gettext("landing.pricing.free.cta")}
        </.link>
        <ul class="mk-price-list">
          <li><span class="mk-price-check">✓</span> {gettext("landing.pricing.free.f1")}</li>
          <li><span class="mk-price-check">✓</span> {gettext("landing.pricing.free.f2")}</li>
          <li><span class="mk-price-check">✓</span> {gettext("landing.pricing.free.f3")}</li>
          <li><span class="mk-price-check">✓</span> {gettext("landing.pricing.free.f4")}</li>
        </ul>
      </div>
      <div class="mk-price mk-price-featured">
        <div class="mk-price-pop">{gettext("landing.pricing.popular")}</div>
        <p class="mk-price-name">{gettext("landing.pricing.pro.name")}</p>
        <p class="mk-price-desc">
          {gettext("landing.pricing.pro.desc")}
        </p>
        <div class="mk-price-amt">$8 <small>{gettext("landing.pricing.pro.period")}</small></div>
        <.link
          navigate={~p"/users/register"}
          class="mk-btn mk-btn-primary"
          style="width:100%;justify-content:center;margin-top:18px"
        >
          {gettext("landing.pricing.pro.cta")}
        </.link>
        <ul class="mk-price-list">
          <li><span class="mk-price-check">✓</span> {gettext("landing.pricing.pro.f1")}</li>
          <li><span class="mk-price-check">✓</span> {gettext("landing.pricing.pro.f2")}</li>
          <li><span class="mk-price-check">✓</span> {gettext("landing.pricing.pro.f3")}</li>
          <li><span class="mk-price-check">✓</span> {gettext("landing.pricing.pro.f4")}</li>
          <li><span class="mk-price-check">✓</span> {gettext("landing.pricing.pro.f5")}</li>
        </ul>
      </div>
      <div class="mk-price">
        <p class="mk-price-name">{gettext("landing.pricing.team.name")}</p>
        <p class="mk-price-desc">{gettext("landing.pricing.team.desc")}</p>
        <div class="mk-price-amt">
          $24 <small>{gettext("landing.pricing.team.period")}</small>
        </div>
        <a
          href="mailto:hello@typster.app"
          class="mk-btn mk-btn-outline"
          style="width:100%;justify-content:center;margin-top:18px"
        >
          {gettext("landing.pricing.team.cta")}
        </a>
        <ul class="mk-price-list">
          <li><span class="mk-price-check">✓</span> {gettext("landing.pricing.team.f1")}</li>
          <li><span class="mk-price-check">✓</span> {gettext("landing.pricing.team.f2")}</li>
          <li><span class="mk-price-check">✓</span> {gettext("landing.pricing.team.f3")}</li>
          <li><span class="mk-price-check">✓</span> {gettext("landing.pricing.team.f4")}</li>
          <li><span class="mk-price-check">✓</span> {gettext("landing.pricing.team.f5")}</li>
        </ul>
      </div>
    </div>
  </div>
</section>
