<section class="mk-hero">
  <div class="mk-pill">
    <span class="mk-pill-dot"></span> {gettext("landing.hero.badge")}
  </div>
  <h1>{raw(gettext("landing.hero.title"))}</h1>
  <p class="mk-hero-sub">
    {gettext("landing.hero.sub")}
  </p>
  <div class="mk-hero-ctas">
    <.link navigate={~p"/users/register"} class="mk-btn mk-btn-primary mk-btn-lg">
      {gettext("landing.hero.cta_primary")} <i data-lucide="arrow-right" class="mk-icon-14"></i>
    </.link>
    <a href="https://github.com/typster-io/typster" class="mk-btn mk-btn-outline mk-btn-lg">
      <i data-lucide="github" class="mk-icon-16"></i> {gettext("landing.hero.cta_github")}
    </a>
  </div>
  <p class="mk-hero-fine">{gettext("landing.hero.fine")}</p>

  <div class="mk-art">
    <div class="mk-mock">
      <div class="mk-mock-bar">
        <span class="mk-mock-dot" style="background:#fb7185"></span>
        <span class="mk-mock-dot" style="background:#fbbf24"></span>
        <span class="mk-mock-dot" style="background:#34d399"></span>
        <span style="margin-left:10px;font-size:12px">quarterly-report / main.typ</span>
        <span style="margin-left:auto;display:flex;gap:6px">
          <span style="padding:2px 8px;border-radius:4px;background:#eef2ff;color:#4f46e5;font-size:11px;font-weight:500">
            {gettext("landing.mock.autosaved")}
          </span>
          <span style="padding:2px 8px;border-radius:4px;background:#f0fdf4;color:#16a34a;font-size:11px;font-weight:500">
            ● {gettext("landing.mock.compiled")}
          </span>
        </span>
      </div>
      <aside class="mk-mock-side">
        <div class="mk-mock-side-h">{gettext("landing.mock.files")}</div>
        <div class="mk-mock-row active">
          <i data-lucide="file" class="mk-icon-12"></i> main.typ
        </div>
        <div class="mk-mock-row">
          <i data-lucide="file" class="mk-icon-12"></i> sections/intro.typ
        </div>
        <div class="mk-mock-row">
          <i data-lucide="file" class="mk-icon-12"></i> sections/data.typ
        </div>
        <div class="mk-mock-row">
          <i data-lucide="file" class="mk-icon-12"></i> refs.bib
        </div>
        <div class="mk-mock-side-h" style="margin-top:12px">{gettext("landing.mock.assets")}</div>
        <div class="mk-mock-row">
          <i data-lucide="image" class="mk-icon-12"></i> cover.png
        </div>
      </aside>
      <div class="mk-mock-src">
        <div class="mk-mock-ln">
          <span class="mk-mock-gn">1</span><span class="mk-tok-comment">{gettext("landing.hero.src.comment")}</span>
        </div>
        <div class="mk-mock-ln">
          <span class="mk-mock-gn">2</span><span class="mk-tok-keyword">#set</span><span> page(margin: </span><span class="mk-tok-string">1in</span><span>, paper: </span><span class="mk-tok-string">"a4"</span><span>)</span>
        </div>
        <div class="mk-mock-ln">
          <span class="mk-mock-gn">3</span><span class="mk-tok-keyword">#set</span><span> text(font: </span><span class="mk-tok-string">"Inter"</span><span>, size: </span><span class="mk-tok-string">11pt</span><span>)</span>
        </div>
        <div class="mk-mock-ln"><span class="mk-mock-gn">4</span></div>
        <div class="mk-mock-ln">
          <span class="mk-mock-gn">5</span><span class="mk-tok-heading">{gettext("landing.hero.src.h1")}</span>
        </div>
        <div class="mk-mock-ln">
          <span class="mk-mock-gn">6</span><span class="mk-tok-keyword">#datetime</span><span>.today().display()</span>
        </div>
        <div class="mk-mock-ln"><span class="mk-mock-gn">7</span></div>
        <div class="mk-mock-ln">
          <span class="mk-mock-gn">8</span><span class="mk-tok-heading">{gettext("landing.hero.src.h2_summary")}</span>
        </div>
        <div class="mk-mock-ln"><span class="mk-mock-gn">9</span></div>
        <div class="mk-mock-ln">
          <span class="mk-mock-gn">10</span><span>{gettext("landing.hero.src.p1a")}</span><span class="mk-tok-em">*Typster*</span><span>{gettext("landing.hero.src.p1b")}</span>
        </div>
        <div class="mk-mock-ln">
          <span class="mk-mock-gn">11</span><span>{gettext("landing.hero.src.p2")}</span>
        </div>
        <div class="mk-mock-ln">
          <span class="mk-mock-gn">12</span><span>{gettext("landing.hero.src.p3a")}</span><span class="mk-tok-em">{gettext("landing.hero.src.p3em")}</span><span>{gettext("landing.hero.src.p3b")}</span>
        </div>
        <div class="mk-mock-ln">
          <span class="mk-mock-gn">13</span><span>{gettext("landing.hero.src.p4")}</span>
        </div>
        <div class="mk-mock-ln"><span class="mk-mock-gn">14</span></div>
        <div class="mk-mock-ln">
          <span class="mk-mock-gn">15</span><span class="mk-tok-heading">{gettext("landing.hero.src.h2_highlights")}</span>
        </div>
        <div class="mk-mock-ln"><span class="mk-mock-gn">16</span></div>
        <div class="mk-mock-ln">
          <span class="mk-mock-gn">17</span><span>{gettext("landing.hero.src.li1")}</span>
        </div>
        <div class="mk-mock-ln">
          <span class="mk-mock-gn">18</span><span>{gettext("landing.hero.src.li2")}</span>
        </div>
        <div class="mk-mock-ln">
          <span class="mk-mock-gn">19</span><span>{gettext("landing.hero.src.li3")}</span>
        </div>
      </div>
      <div class="mk-mock-pdf">
        <div class="mk-mock-pdf-page">
          <div class="mk-mock-pdf-h1">{gettext("landing.hero.pdf.h1")}</div>
          <div class="mk-mock-pdf-date">{gettext("landing.hero.pdf.date")}</div>
          <div class="mk-mock-pdf-h2">{gettext("landing.hero.pdf.h2_summary")}</div>
          <p class="mk-mock-pdf-p">
            {raw(gettext("landing.hero.pdf.summary"))}
          </p>
          <div class="mk-mock-pdf-h2">{gettext("landing.hero.pdf.h2_highlights")}</div>
          <p class="mk-mock-pdf-p">
            {raw(gettext("landing.hero.pdf.highlights"))}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
