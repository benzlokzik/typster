<section class="mk-section mk-section-tinted mk-demo-section">
  <div class="mk-container">
    <p class="mk-eyebrow mk-reveal">{gettext("landing.demo.eyebrow")}</p>
    <h2 class="mk-section-h mk-reveal">
      {gettext("landing.demo.h")}
    </h2>
    <div class="mk-demo-tabs mk-reveal">
      <button class="mk-demo-tab is-active" data-tab="report" onclick="mkSwitchTab(this)">
        {gettext("landing.demo.tab.report")}
      </button>
      <button class="mk-demo-tab" data-tab="cv" onclick="mkSwitchTab(this)">
        {gettext("landing.demo.tab.cv")}
      </button>
      <button class="mk-demo-tab" data-tab="paper" onclick="mkSwitchTab(this)">
        {gettext("landing.demo.tab.paper")}
      </button>
      <button class="mk-demo-tab" data-tab="invoice" onclick="mkSwitchTab(this)">
        {gettext("landing.demo.tab.invoice")}
      </button>
    </div>
    <div class="mk-demo-art mk-reveal">
      <%!-- Report --%>
      <div class="mk-demo-panel is-active" data-panel="report">
        <div class="mk-demo-split">
          <div class="mk-demo-src">
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">1</span><span class="mk-tok-keyword">#set</span><span> page(margin: </span><span class="mk-tok-string">1in</span><span>, paper: </span><span class="mk-tok-string">"a4"</span><span>)</span>
            </div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">2</span><span class="mk-tok-keyword">#set</span><span> text(font: </span><span class="mk-tok-string">"Inter"</span><span>, size: </span><span class="mk-tok-string">11pt</span><span>)</span>
            </div>
            <div class="mk-mock-ln"><span class="mk-mock-gn">3</span></div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">4</span><span class="mk-tok-heading">{gettext("landing.demo.report.src.h1")}</span>
            </div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">5</span><span class="mk-tok-keyword">#datetime</span><span>.today().display()</span>
            </div>
            <div class="mk-mock-ln"><span class="mk-mock-gn">6</span></div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">7</span><span class="mk-tok-heading">{gettext("landing.demo.report.src.h2")}</span>
            </div>
            <div class="mk-mock-ln"><span class="mk-mock-gn">8</span></div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">9</span><span>{gettext("landing.demo.report.src.p1a")}</span><span class="mk-tok-em">*34%*</span><span>{gettext("landing.demo.report.src.p1b")}</span>
            </div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">10</span><span>{gettext("landing.demo.report.src.p2")}</span>
            </div>
            <div class="mk-mock-ln"><span class="mk-mock-gn">11</span></div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">12</span><span class="mk-tok-heading">{gettext("landing.demo.report.src.h3")}</span>
            </div>
            <div class="mk-mock-ln"><span class="mk-mock-gn">13</span></div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">14</span><span class="mk-tok-keyword">#table</span><span>(columns: 2,</span>
            </div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">15</span><span> </span><span class="mk-tok-string">[Metric]</span><span>, </span><span class="mk-tok-string">[Value]</span><span>,</span>
            </div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">16</span><span> </span><span class="mk-tok-string">[MRR]</span><span>, </span><span class="mk-tok-string">[$48k]</span><span>,</span>
            </div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">17</span><span> </span><span class="mk-tok-string">[Users]</span><span>, </span><span class="mk-tok-string">[2,400]</span><span>)</span>
            </div>
          </div>
          <div class="mk-demo-preview">
            <div class="mk-mock-pdf-page">
              <div class="mk-mock-pdf-h1">{gettext("landing.demo.report.pdf.h1")}</div>
              <div class="mk-mock-pdf-date">{gettext("landing.demo.report.pdf.date")}</div>
              <div class="mk-mock-pdf-h2">{gettext("landing.demo.report.pdf.h2")}</div>
              <p class="mk-mock-pdf-p">{raw(gettext("landing.demo.report.pdf.summary"))}</p>
              <div class="mk-mock-pdf-h2">{gettext("landing.demo.report.pdf.h3")}</div>
              <table class="mk-demo-table">
                <tr>
                  <th>{gettext("landing.demo.report.pdf.th_metric")}</th>
                  <th>{gettext("landing.demo.report.pdf.th_value")}</th>
                </tr>
                <tr>
                  <td>MRR</td>
                  <td>$48k</td>
                </tr>
                <tr>
                  <td>{gettext("landing.demo.report.pdf.users")}</td>
                  <td>2,400</td>
                </tr>
              </table>
            </div>
          </div>
        </div>
      </div>
      <%!-- CV --%>
      <div class="mk-demo-panel" data-panel="cv">
        <div class="mk-demo-split">
          <div class="mk-demo-src">
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">1</span><span class="mk-tok-keyword">#set</span><span> text(font: </span><span class="mk-tok-string">"IBM Plex Sans"</span><span>)</span>
            </div>
            <div class="mk-mock-ln"><span class="mk-mock-gn">2</span></div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">3</span><span class="mk-tok-heading">= Jane Smith</span>
            </div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">4</span><span>jane@example.com · github.com/jsmith</span>
            </div>
            <div class="mk-mock-ln"><span class="mk-mock-gn">5</span></div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">6</span><span class="mk-tok-heading">{gettext("landing.demo.cv.src.h_exp")}</span>
            </div>
            <div class="mk-mock-ln"><span class="mk-mock-gn">7</span></div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">8</span><span class="mk-tok-em">*{gettext("landing.demo.cv.src.role")}*</span><span>{gettext("landing.demo.cv.src.role_co")}</span>
            </div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">9</span><span class="mk-tok-comment">{gettext("landing.demo.cv.src.dates")}</span>
            </div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">10</span><span>{gettext("landing.demo.cv.src.li1")}</span>
            </div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">11</span><span>{gettext("landing.demo.cv.src.li2")}</span>
            </div>
            <div class="mk-mock-ln"><span class="mk-mock-gn">12</span></div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">13</span><span class="mk-tok-heading">{gettext("landing.demo.cv.src.h_edu")}</span>
            </div>
            <div class="mk-mock-ln"><span class="mk-mock-gn">14</span></div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">15</span><span>{gettext("landing.demo.cv.src.edu")}</span>
            </div>
          </div>
          <div class="mk-demo-preview">
            <div class="mk-mock-pdf-page">
              <div class="mk-mock-pdf-h1">Jane Smith</div>
              <div class="mk-mock-pdf-date">jane@example.com · github.com/jsmith</div>
              <div class="mk-mock-pdf-h2">{gettext("landing.demo.cv.pdf.h_exp")}</div>
              <p class="mk-mock-pdf-p">
                {raw(gettext("landing.demo.cv.pdf.exp"))}
              </p>
              <div class="mk-mock-pdf-h2">{gettext("landing.demo.cv.pdf.h_edu")}</div>
              <p class="mk-mock-pdf-p">{gettext("landing.demo.cv.pdf.edu")}</p>
            </div>
          </div>
        </div>
      </div>
      <%!-- Paper --%>
      <div class="mk-demo-panel" data-panel="paper">
        <div class="mk-demo-split">
          <div class="mk-demo-src">
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">1</span><span class="mk-tok-keyword">#set</span><span> page(columns: </span><span class="mk-tok-string">2</span><span>, margin: </span><span class="mk-tok-string">.8in</span><span>)</span>
            </div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">2</span><span class="mk-tok-keyword">#set</span><span> par(justify: </span><span class="mk-tok-string">true</span><span>)</span>
            </div>
            <div class="mk-mock-ln"><span class="mk-mock-gn">3</span></div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">4</span><span class="mk-tok-heading">= Attention Is All You Need</span>
            </div>
            <div class="mk-mock-ln"><span class="mk-mock-gn">5</span></div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">6</span><span class="mk-tok-em">*{gettext("landing.demo.paper.src.abstract")}*</span>
            </div>
            <div class="mk-mock-ln"><span class="mk-mock-gn">7</span></div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">8</span><span>{gettext("landing.demo.paper.src.p1")}</span>
            </div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">9</span><span>{gettext("landing.demo.paper.src.p2")}</span>
            </div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">10</span><span>{gettext("landing.demo.paper.src.p3")}</span>
            </div>
            <div class="mk-mock-ln"><span class="mk-mock-gn">11</span></div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">12</span><span class="mk-tok-heading">{gettext("landing.demo.paper.src.h_intro")}</span>
            </div>
            <div class="mk-mock-ln"><span class="mk-mock-gn">13</span></div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">14</span><span>{gettext("landing.demo.paper.src.p4")}</span>
            </div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">15</span><span>{gettext("landing.demo.paper.src.p5a")}</span><span>@vaswani2017.</span>
            </div>
          </div>
          <div class="mk-demo-preview">
            <div class="mk-mock-pdf-page" style="font-size:8.5pt">
              <div class="mk-mock-pdf-h1" style="font-size:13pt;text-align:center">
                Attention Is All You Need
              </div>
              <div class="mk-mock-pdf-date" style="text-align:center">Vaswani et al. · 2017</div>
              <p class="mk-mock-pdf-p">
                {raw(gettext("landing.demo.paper.pdf.abstract"))}
              </p>
              <div class="mk-mock-pdf-h2">{gettext("landing.demo.paper.pdf.h_intro")}</div>
              <p class="mk-mock-pdf-p">
                {gettext("landing.demo.paper.pdf.intro")}
              </p>
            </div>
          </div>
        </div>
      </div>
      <%!-- Invoice --%>
      <div class="mk-demo-panel" data-panel="invoice">
        <div class="mk-demo-split">
          <div class="mk-demo-src">
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">1</span><span class="mk-tok-heading">{gettext("landing.demo.invoice.src.h1")}</span>
            </div>
            <div class="mk-mock-ln"><span class="mk-mock-gn">2</span></div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">3</span><span class="mk-tok-em">*{gettext("landing.demo.invoice.src.from")}*</span><span>{gettext("landing.demo.invoice.src.from_v")}</span>
            </div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">4</span><span class="mk-tok-em">*{gettext("landing.demo.invoice.src.to")}*</span><span>{gettext("landing.demo.invoice.src.to_v")}</span>
            </div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">5</span><span class="mk-tok-em">*{gettext("landing.demo.invoice.src.date")}*</span><span> </span><span class="mk-tok-keyword">#datetime</span><span>.today().display()</span>
            </div>
            <div class="mk-mock-ln"><span class="mk-mock-gn">6</span></div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">7</span><span class="mk-tok-keyword">#table</span><span>(columns: (1fr, auto, auto),</span>
            </div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">8</span><span> </span><span class="mk-tok-string">[Description]</span><span>, </span><span class="mk-tok-string">[Qty]</span><span>, </span><span class="mk-tok-string">[Amount]</span><span>,</span>
            </div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">9</span><span> </span><span class="mk-tok-string">[Design work]</span><span>, </span><span class="mk-tok-string">[8h]</span><span>, </span><span class="mk-tok-string">[$960]</span><span>,</span>
            </div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">10</span><span> </span><span class="mk-tok-string">[Development]</span><span>, </span><span class="mk-tok-string">[16h]</span><span>, </span><span class="mk-tok-string">[$2,400]</span><span>,</span>
            </div>
            <div class="mk-mock-ln"><span class="mk-mock-gn">11</span><span>)</span></div>
            <div class="mk-mock-ln"><span class="mk-mock-gn">12</span></div>
            <div class="mk-mock-ln">
              <span class="mk-mock-gn">13</span><span class="mk-tok-em">*{gettext("landing.demo.invoice.src.total")}*</span>
            </div>
          </div>
          <div class="mk-demo-preview">
            <div class="mk-mock-pdf-page">
              <div class="mk-mock-pdf-h1">{gettext("landing.demo.invoice.pdf.h1")}</div>
              <div class="mk-mock-pdf-date">{gettext("landing.demo.invoice.pdf.date")}</div>
              <p class="mk-mock-pdf-p" style="margin-bottom:4px">
                {raw(gettext("landing.demo.invoice.pdf.fromto"))}
              </p>
              <table class="mk-demo-table" style="margin-top:12px">
                <tr>
                  <th>{gettext("landing.demo.invoice.pdf.th_desc")}</th>
                  <th>{gettext("landing.demo.invoice.pdf.th_qty")}</th>
                  <th>{gettext("landing.demo.invoice.pdf.th_amount")}</th>
                </tr>
                <tr>
                  <td>{gettext("landing.demo.invoice.pdf.r1")}</td>
                  <td>8h</td>
                  <td>$960</td>
                </tr>
                <tr>
                  <td>{gettext("landing.demo.invoice.pdf.r2")}</td>
                  <td>16h</td>
                  <td>$2,400</td>
                </tr>
              </table>
              <p class="mk-mock-pdf-p" style="margin-top:12px;font-weight:700;font-size:11pt">
                {gettext("landing.demo.invoice.pdf.total")}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
