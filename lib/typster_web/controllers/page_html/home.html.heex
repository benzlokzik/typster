<.hero />

<%!-- Stats ────────────────────────────────────────────────────────── --%>
<div class="mk-stats mk-reveal">
  <div class="mk-stats-grid mk-reveal-group">
    <div class="mk-stat">
      <div class="mk-stat-n">2<span>,400</span></div>
      <div class="mk-stat-l">{gettext("landing.stats.weekly")}</div>
    </div>
    <div class="mk-stat">
      <div class="mk-stat-n">18<span>k</span></div>
      <div class="mk-stat-l">{gettext("landing.stats.pdfs")}</div>
    </div>
    <div class="mk-stat">
      <div class="mk-stat-n"><span>~</span>200ms</div>
      <div class="mk-stat-l">{gettext("landing.stats.save")}</div>
    </div>
    <div class="mk-stat">
      <div class="mk-stat-n">100<span>%</span></div>
      <div class="mk-stat-l">{gettext("landing.stats.browser")}</div>
    </div>
  </div>
</div>

<%!-- How it works ──────────────────────────────────────────────────── --%>
<section class="mk-section mk-hiw-section">
  <div class="mk-container">
    <p class="mk-eyebrow mk-reveal">{gettext("landing.hiw.eyebrow")}</p>
    <h2 class="mk-section-h mk-reveal">{gettext("landing.hiw.h")}</h2>
    <div class="mk-hiw-steps mk-reveal-group">
      <div class="mk-hiw-step">
        <div class="mk-hiw-num">01</div>
        <h3 class="mk-hiw-title">{gettext("landing.hiw.write.title")}</h3>
        <p class="mk-hiw-desc">
          {gettext("landing.hiw.write.desc")}
        </p>
      </div>
      <div class="mk-hiw-step">
        <div class="mk-hiw-num">02</div>
        <h3 class="mk-hiw-title">{gettext("landing.hiw.compile.title")}</h3>
        <p class="mk-hiw-desc">
          {gettext("landing.hiw.compile.desc")}
        </p>
      </div>
      <div class="mk-hiw-step">
        <div class="mk-hiw-num">03</div>
        <h3 class="mk-hiw-title">{gettext("landing.hiw.share.title")}</h3>
        <p class="mk-hiw-desc">
          {gettext("landing.hiw.share.desc")}
        </p>
      </div>
    </div>
  </div>
</section>

<%!-- Features ─────────────────────────────────────────────────────── --%>
<section id="features" class="mk-section mk-section-tinted">
  <div class="mk-container">
    <p class="mk-eyebrow mk-reveal">{gettext("landing.features.eyebrow")}</p>
    <h2 class="mk-section-h mk-reveal">{gettext("landing.features.h")}</h2>
    <p class="mk-section-sub mk-reveal">
      {gettext("landing.features.sub")}
    </p>
    <div class="mk-feat-grid mk-reveal-group">
      <.icon_card icon="zap">
        <:title>{gettext("landing.feat.compile.title")}</:title>
        <:body>
          {gettext("landing.feat.compile.body")}
        </:body>
      </.icon_card>
      <.icon_card icon="command">
        <:title>{gettext("landing.feat.keyboard.title")}</:title>
        <:body>
          {gettext("landing.feat.keyboard.body")}
        </:body>
      </.icon_card>
      <.icon_card icon="eye">
        <:title>{gettext("landing.feat.layout.title")}</:title>
        <:body>
          {gettext("landing.feat.layout.body")}
        </:body>
      </.icon_card>
      <.icon_card icon="cloud-upload">
        <:title>{gettext("landing.feat.cloud.title")}</:title>
        <:body>
          {gettext("landing.feat.cloud.body")}
        </:body>
      </.icon_card>
      <.icon_card icon="share-2">
        <:title>{gettext("landing.feat.share.title")}</:title>
        <:body>
          {gettext("landing.feat.share.body")}
        </:body>
      </.icon_card>
      <.icon_card icon="type">
        <:title>{gettext("landing.feat.fonts.title")}</:title>
        <:body>
          {gettext("landing.feat.fonts.body")}
        </:body>
      </.icon_card>
    </div>
  </div>
</section>

<%!-- Keyboard band ────────────────────────────────────────────────── --%>
<section class="mk-section mk-kb-band">
  <p class="mk-eyebrow">{gettext("landing.kb.eyebrow")}</p>
  <h2 class="mk-section-h">{gettext("landing.kb.h")}</h2>
  <p class="mk-section-sub">
    {gettext("landing.kb.sub")}
  </p>
  <div class="mk-kb-grid mk-reveal-group">
    <div class="mk-kb-row">
      <span class="mk-kb-label">{gettext("landing.kb.save")}</span>
      <span class="mk-kb-keys"><kbd class="mk-kb-key">⌘</kbd><kbd class="mk-kb-key">S</kbd></span>
    </div>
    <div class="mk-kb-row">
      <span class="mk-kb-label">{gettext("landing.kb.palette")}</span>
      <span class="mk-kb-keys">
        <kbd class="mk-kb-key">⌘</kbd><kbd class="mk-kb-key">⇧</kbd><kbd class="mk-kb-key">P</kbd>
      </span>
    </div>
    <div class="mk-kb-row">
      <span class="mk-kb-label">{gettext("landing.kb.sidebar")}</span>
      <span class="mk-kb-keys"><kbd class="mk-kb-key">⌘</kbd><kbd class="mk-kb-key">B</kbd></span>
    </div>
    <div class="mk-kb-row">
      <span class="mk-kb-label">{gettext("landing.kb.preview")}</span>
      <span class="mk-kb-keys"><kbd class="mk-kb-key">⌘</kbd><kbd class="mk-kb-key">E</kbd></span>
    </div>
    <div class="mk-kb-row">
      <span class="mk-kb-label">{gettext("landing.kb.search")}</span>
      <span class="mk-kb-keys"><kbd class="mk-kb-key">⌘</kbd><kbd class="mk-kb-key">/</kbd></span>
    </div>
    <div class="mk-kb-row">
      <span class="mk-kb-label">{gettext("landing.kb.newfile")}</span>
      <span class="mk-kb-keys"><kbd class="mk-kb-key">⌘</kbd><kbd class="mk-kb-key">N</kbd></span>
    </div>
    <div class="mk-kb-row">
      <span class="mk-kb-label">{gettext("landing.kb.closefile")}</span>
      <span class="mk-kb-keys"><kbd class="mk-kb-key">⌘</kbd><kbd class="mk-kb-key">W</kbd></span>
    </div>
    <div class="mk-kb-row">
      <span class="mk-kb-label">{gettext("landing.kb.switch")}</span>
      <span class="mk-kb-keys">
        <kbd class="mk-kb-key">⌘</kbd><kbd class="mk-kb-key">1-9</kbd>
      </span>
    </div>
  </div>
</section>

<.demo />

<%!-- Use cases ─────────────────────────────────────────────────────── --%>
<section class="mk-section mk-usecase-section">
  <div class="mk-container">
    <p class="mk-eyebrow mk-reveal">{gettext("landing.usecase.eyebrow")}</p>
    <h2 class="mk-section-h mk-reveal">{raw(gettext("landing.usecase.h"))}</h2>
    <div class="mk-usecase-grid mk-reveal-group">
      <.icon_card class="mk-usecase" icon_class="mk-usecase-icon" icon="graduation-cap">
        <:title>{gettext("landing.usecase.academic.title")}</:title>
        <:body>
          {gettext("landing.usecase.academic.body")}
        </:body>
      </.icon_card>
      <.icon_card class="mk-usecase" icon_class="mk-usecase-icon" icon="file-text">
        <:title>{gettext("landing.usecase.cv.title")}</:title>
        <:body>
          {gettext("landing.usecase.cv.body")}
        </:body>
      </.icon_card>
      <.icon_card class="mk-usecase" icon_class="mk-usecase-icon" icon="chart-no-axes-column">
        <:title>{gettext("landing.usecase.reports.title")}</:title>
        <:body>
          {gettext("landing.usecase.reports.body")}
        </:body>
      </.icon_card>
      <.icon_card class="mk-usecase" icon_class="mk-usecase-icon" icon="receipt-text">
        <:title>{gettext("landing.usecase.invoices.title")}</:title>
        <:body>
          {gettext("landing.usecase.invoices.body")}
        </:body>
      </.icon_card>
      <.icon_card class="mk-usecase" icon_class="mk-usecase-icon" icon="notebook-pen">
        <:title>{gettext("landing.usecase.notes.title")}</:title>
        <:body>
          {gettext("landing.usecase.notes.body")}
        </:body>
      </.icon_card>
    </div>
  </div>
</section>

<%!-- Roadmap ──────────────────────────────────────────────────────── --%>
<section class="mk-section mk-section-tinted">
  <div class="mk-container">
    <p class="mk-eyebrow mk-reveal">{gettext("landing.roadmap.eyebrow")}</p>
    <h2 class="mk-section-h mk-reveal">{raw(gettext("landing.roadmap.h"))}</h2>
    <p class="mk-section-sub mk-reveal">
      {gettext("landing.roadmap.sub")}
    </p>
    <div class="mk-feat-grid mk-reveal-group">
      <.icon_card icon="users">
        <:title>
          {gettext("landing.roadmap.collab.title")}
          <span class="mk-badge mk-badge-primary mk-badge-sm">
            {gettext("landing.badge.soon")}
          </span>
        </:title>
        <:body>
          {gettext("landing.roadmap.collab.body")}
        </:body>
      </.icon_card>
      <.icon_card icon="book-text">
        <:title>
          {gettext("landing.roadmap.zotero.title")}
          <span class="mk-badge mk-badge-primary mk-badge-sm">
            {gettext("landing.badge.soon")}
          </span>
        </:title>
        <:body>
          {raw(gettext("landing.roadmap.zotero.body"))}
        </:body>
      </.icon_card>
      <.icon_card icon="sparkles">
        <:title>
          {gettext("landing.roadmap.ai.title")}
          <span class="mk-badge mk-badge-primary mk-badge-sm">
            {gettext("landing.badge.soon")}
          </span>
        </:title>
        <:body>
          {gettext("landing.roadmap.ai.body")}
        </:body>
      </.icon_card>
      <.icon_card icon="file-input">
        <:title>
          {gettext("landing.roadmap.source.title")}
          <span class="mk-badge mk-badge-default mk-badge-sm">
            {gettext("landing.badge.later")}
          </span>
        </:title>
        <:body>
          {gettext("landing.roadmap.source.body")}
        </:body>
      </.icon_card>
      <.icon_card icon="pen-line">
        <:title>
          {gettext("landing.roadmap.wysiwyg.title")}
          <span class="mk-badge mk-badge-default mk-badge-sm">
            {gettext("landing.badge.later")}
          </span>
        </:title>
        <:body>
          {gettext("landing.roadmap.wysiwyg.body")}
        </:body>
      </.icon_card>
    </div>
  </div>
</section>

<.pricing_section />

<%!-- FAQ ─────────────────────────────────────────────────────────── --%>
<section id="faq" class="mk-section">
  <div class="mk-container">
    <p class="mk-eyebrow mk-reveal">{gettext("landing.faq.eyebrow")}</p>
    <h2 class="mk-section-h mk-reveal">{gettext("landing.faq.h")}</h2>
    <div class="mk-faq mk-reveal-group">
      <details class="mk-faq-item">
        <summary>{gettext("landing.faq.q1")} <span class="mk-faq-icon">+</span></summary>
        <p>
          {gettext("landing.faq.a1")}
        </p>
      </details>
      <details class="mk-faq-item">
        <summary>{gettext("landing.faq.q2")} <span class="mk-faq-icon">+</span></summary>
        <p>
          {gettext("landing.faq.a2")}
        </p>
      </details>
      <details class="mk-faq-item">
        <summary>
          {gettext("landing.faq.q3")} <span class="mk-faq-icon">+</span>
        </summary>
        <p>
          {raw(gettext("landing.faq.a3"))}
        </p>
      </details>
      <details class="mk-faq-item">
        <summary>{gettext("landing.faq.q4")} <span class="mk-faq-icon">+</span></summary>
        <p>
          {gettext("landing.faq.a4")}
        </p>
      </details>
      <details class="mk-faq-item">
        <summary>{gettext("landing.faq.q5")} <span class="mk-faq-icon">+</span></summary>
        <p>
          {gettext("landing.faq.a5")}
        </p>
      </details>
      <details class="mk-faq-item">
        <summary>{gettext("landing.faq.q6")} <span class="mk-faq-icon">+</span></summary>
        <p>
          {gettext("landing.faq.a6")}
        </p>
      </details>
    </div>
  </div>
</section>

<%!-- CTA band ─────────────────────────────────────────────────────── --%>
<section class="mk-cta-band">
  <h2>{raw(gettext("landing.cta.h"))}</h2>
  <p>{gettext("landing.cta.sub")}</p>
  <.link navigate={~p"/users/register"} class="mk-btn mk-btn-light mk-btn-lg">
    {gettext("landing.cta.button")} <i data-lucide="arrow-right" class="mk-icon-14"></i>
  </.link>
</section>

<%!-- Footer ──────────────────────────────────────────────────────── --%>
<footer class="mk-foot">
  <div class="mk-foot-inner">
    <div class="mk-foot-brand">
      <div class="mk-brand">
        <div class="mk-brand-mark">T</div>
        <span>Typster</span>
      </div>
      <p>{raw(gettext("landing.foot.tagline"))}</p>
    </div>
    <div class="mk-foot-cols">
      <div class="mk-foot-col">
        <h5>{gettext("landing.foot.product")}</h5>
        <a href="#features">{gettext("landing.foot.features")}</a>
        <a href="#pricing">{gettext("landing.foot.pricing")}</a>
        <a href="#">{gettext("landing.foot.changelog")}</a>
        <a href="#">{gettext("landing.foot.roadmap")}</a>
      </div>
      <div class="mk-foot-col">
        <h5>{gettext("landing.foot.resources")}</h5>
        <a href="https://typst.app/docs" target="_blank">{gettext("landing.foot.docs")}</a>
        <a href="#">{gettext("landing.foot.guide")}</a>
        <a href="#">{gettext("landing.foot.templates")}</a>
        <a href="#">{gettext("landing.foot.status")}</a>
      </div>
      <div class="mk-foot-col">
        <h5>{gettext("landing.foot.company")}</h5>
        <a href="#">{gettext("landing.foot.about")}</a>
        <a href="#">{gettext("landing.foot.blog")}</a>
        <a href="#">{gettext("landing.foot.contact")}</a>
        <a href="#">{gettext("landing.foot.privacy")}</a>
      </div>
    </div>
  </div>
  <div class="mk-foot-bottom">
    <span>{gettext("landing.foot.copyright")}</span>
    <span>{gettext("landing.foot.madewith")}</span>
  </div>
</footer>
