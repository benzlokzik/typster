<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="ts-editor" id="editor-shell" phx-hook="CommandPalette">
    <%!-- Editor top bar: breadcrumb, save status, actions --%>
    <div class="ts-editor__bar">
      <.link
        navigate={~p"/projects"}
        class="ts-btn ts-btn--ghost ts-btn--icon ts-btn--sm"
        aria-label={gettext("nav.projects")}
        title={gettext("nav.projects")}
      >
        <.icon name="hero-chevron-left" class="size-3" />
      </.link>
      <nav class="ts-crumb" aria-label={gettext("editor.breadcrumb")}>
        <span class="ts-crumb__seg">{@project.name}</span>
        <span :for={seg <- path_segments(@current_file)}>
          <span class="ts-crumb__sep">/</span>
          <span class={["ts-crumb__seg", seg.last && "is-active"]}>{seg.name}</span>
        </span>
      </nav>

      <div
        id="save-status"
        phx-hook="SaveStatus"
        class={"ts-savestat ts-savestat--#{@save_status}"}
      >
        <span class="ts-savestat__dot"></span>
        <span class="ts-savestat__label">{save_status_label(@save_status)}</span>
      </div>

      <div class="ts-spacer" />

      <button
        type="button"
        class="ts-btn ts-btn--ghost ts-btn--sm ts-cmdk"
        phx-click="open_palette"
        aria-label={gettext("editor.command_open")}
      >
        <span class="ts-cmdk__icon ts-mac" aria-hidden="true"><i data-lucide="command"></i></span>
        <span class="ts-cmdk__icon ts-other" aria-hidden="true">
          <i data-lucide="square-terminal"></i>
        </span>
        <%!-- The ⌘ icon already conveys the modifier, so the Mac key is just "K"
             (avoids a duplicated ⌘). Non-mac spells out "Ctrl" beside the icon. --%>
        <span class="ts-kbd ts-mac">K</span>
        <span class="ts-kbd ts-other">Ctrl K</span>
      </button>
      <button
        type="button"
        class="ts-btn ts-btn--ghost ts-btn--sm"
        disabled
        title={gettext("editor.share_soon")}
      >
        <.icon name="hero-arrow-up-tray" class="size-3" /> {gettext("editor.share")}
      </button>
      <button
        type="button"
        class="ts-btn ts-btn--primary ts-btn--sm"
        phx-click={JS.dispatch("phx:editor-command", detail: %{cmd: "compile"})}
      >
        <.icon name="hero-play" class="size-3" /> {gettext("editor.compile")}
      </button>
    </div>

    <%!-- Three-pane window --%>
    <div class="ts-editor__body">
      <div class="ts-window ts-editor__panes">
        <%!-- Sidebar: file tree + outline + assets --%>
        <aside class="ts-side" id="editor-sidebar" phx-hook="LucideIcons">
          <div class="ts-side__search">
            <div class="ts-search ts-search--sm">
              <.icon name="hero-magnifying-glass" class="size-3.5" />
              <input
                placeholder={gettext("editor.find_in_project")}
                aria-label={gettext("editor.find_in_project")}
              />
            </div>
          </div>

          <div class="ts-side__head">
            <span>{gettext("editor.files")}</span>
            <div class="ts-side__actions">
              <button
                type="button"
                class="ts-btn ts-btn--ghost ts-btn--sm ts-viewmenu__btn"
                phx-click={JS.toggle(to: "#file-viewmenu")}
                aria-label={gettext("editor.view.label")}
              >
                <.icon name="hero-arrows-right-left" class="size-3" />
                {TypsterWeb.FileTree.view_label(@file_view_mode)}
              </button>
              <button
                id="create-folder-button"
                phx-click="new_folder"
                class="ts-btn ts-btn--ghost ts-btn--icon ts-btn--sm"
                aria-label={gettext("editor.new_folder")}
              >
                <.icon name="hero-folder-plus" class="size-3" />
              </button>
              <button
                id="create-main-file-button"
                phx-click="new_file"
                class="ts-btn ts-btn--ghost ts-btn--icon ts-btn--sm"
                aria-label={gettext("editor.new_file")}
              >
                <.icon name="hero-plus" class="size-3" />
              </button>
            </div>
          </div>

          <div
            id="file-viewmenu"
            class="ts-viewmenu__pop hidden"
            phx-click-away={JS.hide(to: "#file-viewmenu")}
          >
            <button
              :for={
                {m, label, desc} <- [
                  {"tree", gettext("editor.view.tree"), gettext("editor.view.tree_desc")},
                  {"smart", gettext("editor.view.smart_label"),
                   gettext("editor.view.smart_desc")},
                  {"flat", gettext("editor.view.flat_label"), gettext("editor.view.flat_desc")}
                ]
              }
              type="button"
              class={["ts-viewmenu__opt", to_string(@file_view_mode) == m && "is-on"]}
              phx-click={
                JS.hide(to: "#file-viewmenu") |> JS.push("set_file_view", value: %{mode: m})
              }
            >
              <.icon
                :if={to_string(@file_view_mode) == m}
                name="hero-check"
                class="size-3 ts-viewmenu__check"
              />
              <span :if={to_string(@file_view_mode) != m} class="ts-viewmenu__dot"></span>
              <span>
                <strong>{label}</strong>
                <em>{desc}</em>
              </span>
            </button>
          </div>

          <div :if={pinned_files(@file_tree) != []}>
            <div class="ts-side__head ts-side__head--sub">{gettext("editor.pinned")}</div>
            <ul class="ts-tree">
              <TypsterWeb.FileTree.tree_rows
                nodes={TypsterWeb.FileTree.file_nodes(pinned_files(@file_tree), :flat)}
                collapsed={@collapsed_dirs}
                current_id={@current_file && @current_file.id}
              />
            </ul>
            <div class="ts-side__head ts-side__head--sub">{gettext("editor.files")}</div>
          </div>

          <%= if Enum.empty?(@file_tree) and Enum.empty?(@assets) and not @creating? do %>
            <div class="ts-empty" style="margin: 8px 14px; padding: 20px 12px;">
              {gettext("editor.no_files")}
            </div>
          <% else %>
            <ul class="ts-tree">
              <li :if={@creating?} class="ts-tree__draft" id="new-file-draft">
                <.form
                  for={%{}}
                  id="new-file-form"
                  phx-change={@new_kind == :file && "suggest_new_file"}
                  phx-submit={
                    if(@new_kind == :folder,
                      do: "create_folder_from_dialog",
                      else: "create_file_from_dialog"
                    )
                  }
                  phx-window-keydown="cancel_new_file"
                  phx-key="Escape"
                  phx-click-away="cancel_new_file"
                >
                  <div class="ts-draft__row">
                    <span :if={@new_kind == :folder} class="ts-tree__ficon" aria-hidden="true">
                      <i data-lucide="folder"></i>
                    </span>
                    <span
                      :if={@new_kind == :file}
                      class={[
                        "ts-filechip",
                        "ts-filechip--#{draft_chip_ext(@new_file_name, @new_file_suggestions)}"
                      ]}
                    >
                      {chip_glyph(draft_chip_ext(@new_file_name, @new_file_suggestions))}
                    </span>
                    <input
                      class="ts-draft__input"
                      name="path"
                      value={@new_file_name}
                      placeholder={
                        if(@new_kind == :folder,
                          do: gettext("editor.newfolder.placeholder"),
                          else: gettext("editor.newfile.placeholder")
                        )
                      }
                      autocomplete="off"
                      spellcheck="false"
                      phx-mounted={JS.focus()}
                    />
                    <button
                      :if={@new_kind == :file and length(@new_file_suggestions) == 1}
                      type="button"
                      class="ts-exthint"
                      phx-click="create_file_from_dialog"
                      phx-value-path={hd(@new_file_suggestions)}
                      title={gettext("editor.newfile.append_hint")}
                    >
                      + {draft_hint(@new_file_name, @new_file_suggestions)}
                    </button>
                  </div>
                  <div
                    :if={@new_kind == :file and length(@new_file_suggestions) > 1}
                    class="ts-suggest"
                  >
                    <button
                      :for={suggestion <- @new_file_suggestions}
                      type="button"
                      class="ts-suggest__chip"
                      phx-click="create_file_from_dialog"
                      phx-value-path={suggestion}
                    >
                      <span class={["ts-filechip", "ts-filechip--#{ext_label(suggestion)}"]}>
                        {chip_glyph(ext_label(suggestion))}
                      </span>
                      {Path.basename(suggestion)}
                    </button>
                  </div>
                </.form>
              </li>
              <TypsterWeb.FileTree.tree_rows
                nodes={
                  TypsterWeb.FileTree.file_nodes(unpinned_files(@file_tree), @file_view_mode)
                }
                collapsed={@collapsed_dirs}
                current_id={@current_file && @current_file.id}
              />
            </ul>
          <% end %>

          <div class="ts-side__head">
            <span>{gettext("editor.outline")}</span>
            <span :if={@outline_count > 0} class="ts-side__count">
              {ngettext("%{count} section", "%{count} sections", @outline_count)}
            </span>
          </div>
          <ul id="outline" phx-update="stream" class="ts-outline">
            <li class="ts-outline__empty only:block hidden" id="outline-empty">
              {gettext("editor.outline_empty")}
            </li>
            <li
              :for={{id, heading} <- @streams.outline}
              id={id}
              class={["ts-outline__item", "level-#{heading.level}"]}
              phx-click={
                JS.dispatch("phx:editor-command", detail: %{cmd: "goto", line: heading.line})
              }
            >
              <span :if={heading.num != ""} class="ts-outline__num">{heading.num}</span>
              <span class="truncate">{heading.text}</span>
            </li>
          </ul>

          <div class="ts-side__head" style="margin-top: auto;">
            <span>{gettext("editor.assets")}</span>
            <div class="ts-side__actions">
              <label
                for="asset-file-input"
                class="ts-btn ts-btn--ghost ts-btn--icon ts-btn--sm"
                aria-label={gettext("editor.upload_asset")}
                style="cursor: pointer;"
              >
                <.icon name="hero-arrow-up-tray" class="size-3" />
              </label>
            </div>
          </div>

          <ul class="ts-tree">
            <TypsterWeb.FileTree.tree_rows
              nodes={TypsterWeb.FileTree.asset_nodes(@assets, @file_view_mode)}
              collapsed={@collapsed_dirs}
            />
          </ul>

          <div class="ts-side__upload">
            <.form
              id="asset-upload-form"
              for={%{}}
              phx-change="validate_upload"
              phx-submit="save_upload"
            >
              <.live_file_input upload={@uploads.asset} id="asset-file-input" class="hidden" />
              <button
                id="upload-asset-button"
                type="submit"
                class="ts-btn ts-btn--outline ts-btn--sm"
                style="width: 100%;"
              >
                {gettext("editor.upload_asset")}
              </button>
            </.form>
          </div>

          <div class="ts-side__head">
            <span>{gettext("editor.templates")}</span>
            <span :if={@templates != []} class="ts-side__count">{length(@templates)}</span>
          </div>

          <div class="ts-tpl">
            <div :for={tpl <- @templates} class="ts-tpl__row">
              <% kind = TypsterWeb.FileTree.file_chip_kind(tpl.name) %>
              <span class={["ts-filechip", "ts-filechip--#{kind}"]}>
                {TypsterWeb.FileTree.chip_glyph(kind)}
              </span>
              <span class="ts-tpl__name truncate">{tpl.name}</span>
              <button
                type="button"
                class="ts-tree__act"
                phx-click="use_template"
                phx-value-id={tpl.id}
                aria-label={gettext("editor.tpl.use")}
                title={gettext("editor.tpl.use")}
              >
                <.icon name="hero-arrow-right" class="size-3" />
              </button>
              <button
                type="button"
                class="ts-tree__act ts-tree__act--danger"
                phx-click="delete_template"
                phx-value-id={tpl.id}
                phx-confirm={gettext("editor.tpl.delete_confirm")}
                aria-label={gettext("editor.tree.delete")}
                title={gettext("editor.tree.delete")}
              >
                <.icon name="hero-trash" class="size-3" />
              </button>
            </div>

            <.form
              id="template-upload-form"
              for={%{}}
              phx-change="validate_template"
              phx-submit="save_template"
            >
              <.live_file_input
                upload={@uploads.template}
                id="template-file-input"
                class="hidden"
              />
              <label for="template-file-input" class="ts-tpl__drop">
                <.icon name="hero-arrow-up-tray" class="size-3.5" />
                <span>{gettext("editor.tpl.upload")}</span>
              </label>
              <button
                :if={@uploads.template.entries != []}
                id="save-template-button"
                type="submit"
                class="ts-btn ts-btn--primary ts-btn--sm"
                style="width: 100%; margin-top: 6px;"
              >
                {gettext("editor.tpl.save")}
              </button>
            </.form>
          </div>
        </aside>

        <%!-- Source pane: tab bar + formatting toolbar + CodeMirror --%>
        <section class="ts-source">
          <div class="ts-source__tabs" id="editor-tabs" phx-hook="LucideIcons">
            <%= for file <- open_tabs(@file_tree, @open_file_ids) do %>
              <% {folder, name} = split_path(file.path) %>
              <% kind = TypsterWeb.FileTree.file_chip_kind(file.path) %>
              <div
                class={["ts-tab", @current_file && @current_file.id == file.id && "is-active"]}
                phx-click="select_file"
                phx-value-file-id={file.id}
              >
                <span :if={file.pinned} class="ts-tab__pin" title={gettext("editor.tree.pinned")}>
                  <i data-lucide="pin" aria-hidden="true"></i>
                </span>
                <span class={["ts-filechip", "ts-filechip--#{kind}"]}>
                  {TypsterWeb.FileTree.chip_glyph(kind)}
                </span>
                <span class="ts-tab__label">
                  <span :if={folder} class="ts-tab__folder">{folder}/</span>{name}
                </span>
                <span
                  class="ts-tab__close"
                  phx-click="close_tab"
                  phx-value-id={file.id}
                  aria-label={gettext("editor.tab.close")}
                >
                  <.icon name="hero-x-mark" class="size-3" />
                </span>
              </div>
            <% end %>
            <div :if={@open_file_ids == []} class="ts-tab is-active ts-tab--empty">
              {gettext("editor.no_file")}
            </div>
          </div>

          <div class="ts-formatbar">
            <button
              type="button"
              class="ts-btn ts-btn--ghost ts-btn--icon ts-btn--sm"
              phx-click={JS.dispatch("phx:editor-command", detail: %{cmd: "bold"})}
              aria-label={gettext("editor.format.bold")}
              title={gettext("editor.format.bold")}
            >
              <i data-lucide="bold" aria-hidden="true"></i>
            </button>
            <button
              type="button"
              class="ts-btn ts-btn--ghost ts-btn--icon ts-btn--sm"
              phx-click={JS.dispatch("phx:editor-command", detail: %{cmd: "italic"})}
              aria-label={gettext("editor.format.italic")}
              title={gettext("editor.format.italic")}
            >
              <i data-lucide="italic" aria-hidden="true"></i>
            </button>
            <span class="ts-formatbar__sep"></span>
            <button
              type="button"
              class="ts-btn ts-btn--ghost ts-btn--icon ts-btn--sm"
              phx-click={JS.dispatch("phx:editor-command", detail: %{cmd: "heading"})}
              aria-label={gettext("editor.format.heading")}
              title={gettext("editor.format.heading")}
            >
              <i data-lucide="heading" aria-hidden="true"></i>
            </button>
            <button
              type="button"
              class="ts-btn ts-btn--ghost ts-btn--icon ts-btn--sm"
              phx-click={JS.dispatch("phx:editor-command", detail: %{cmd: "list"})}
              aria-label={gettext("editor.format.list")}
              title={gettext("editor.format.list")}
            >
              <i data-lucide="list" aria-hidden="true"></i>
            </button>
            <span class="ts-formatbar__sep"></span>
            <button
              type="button"
              class="ts-btn ts-btn--ghost ts-btn--icon ts-btn--sm"
              phx-click={JS.dispatch("phx:editor-command", detail: %{cmd: "math"})}
              aria-label={gettext("editor.format.math")}
              title={gettext("editor.format.math")}
            >
              <i data-lucide="sigma" aria-hidden="true"></i>
            </button>
            <button
              type="button"
              class="ts-btn ts-btn--ghost ts-btn--icon ts-btn--sm"
              phx-click={JS.dispatch("phx:editor-command", detail: %{cmd: "link"})}
              aria-label={gettext("editor.format.link")}
              title={gettext("editor.format.link")}
            >
              <i data-lucide="link-2" aria-hidden="true"></i>
            </button>
            <button
              type="button"
              class="ts-btn ts-btn--ghost ts-btn--icon ts-btn--sm"
              phx-click={JS.dispatch("phx:editor-command", detail: %{cmd: "table"})}
              aria-label={gettext("editor.format.table")}
              title={gettext("editor.format.table")}
            >
              <i data-lucide="table" aria-hidden="true"></i>
            </button>
            <span class="ts-formatbar__sep"></span>
            <button
              type="button"
              class="ts-btn ts-btn--ghost ts-btn--icon ts-btn--sm"
              phx-click={JS.dispatch("phx:editor-command", detail: %{cmd: "image"})}
              aria-label={gettext("editor.format.image")}
              title={gettext("editor.format.image")}
            >
              <i data-lucide="image" aria-hidden="true"></i>
            </button>
            <span class="ts-formatbar__sep"></span>
            <button
              type="button"
              class="ts-btn ts-btn--ghost ts-btn--icon ts-btn--sm"
              phx-click={JS.dispatch("phx:editor-command", detail: %{cmd: "search"})}
              aria-label={gettext("editor.find")}
              title={gettext("editor.find")}
            >
              <i data-lucide="search" aria-hidden="true"></i>
            </button>
            <span :if={@current_file} class="ts-formatbar__hint">
              {@editor_language} · {@current_file.path}
            </span>
          </div>

          <div
            id="editor-container"
            phx-hook="CodeMirror"
            phx-update="ignore"
            data-content={@content}
            data-file-id={if @current_file, do: @current_file.id, else: ""}
            data-file-name={if @current_file, do: @current_file.path, else: ""}
            data-language={@editor_language}
            data-project-sources={Jason.encode!(@project_sources)}
            data-project-assets={Jason.encode!(@project_assets)}
            class="ts-source__editor"
            style={if !@current_file, do: "display:none", else: ""}
          >
          </div>
          <div :if={!@current_file} class="ts-emptystate">
            <div class="ts-emptystate__tile ts-serif">T</div>
            <h3 class="ts-emptystate__title">
              {gettext("editor.empty.title_lead")}
              <span class="ts-serif">{gettext("editor.empty.title_accent")}</span>
            </h3>
            <p class="ts-emptystate__sub">{gettext("editor.empty.sub")}</p>
            <div class="ts-emptystate__actions">
              <button type="button" phx-click="new_file" class="ts-btn ts-btn--primary ts-btn--sm">
                <.icon name="hero-plus" class="size-3" /> {gettext("editor.empty.new_file")}
              </button>
              <button
                type="button"
                class="ts-btn ts-btn--outline ts-btn--sm"
                disabled
                title={gettext("editor.empty.template_soon")}
              >
                {gettext("editor.empty.open_template")}
              </button>
            </div>
          </div>
        </section>

        <%!-- Preview pane --%>
        <section class="ts-preview">
          <div class="ts-preview__bar">
            <span>{gettext("editor.preview")}</span>
            <%= cond do %>
              <% @preview_error -> %>
                <span class="ts-pill ts-pill--error">
                  <span class="ts-pill__dot"></span>{gettext("editor.preview_failed")}
                </span>
              <% @preview_compiling -> %>
                <span class="ts-pill ts-pill--accent">
                  <span class="ts-pill__dot"></span>{gettext("editor.compiling")}
                </span>
              <% @preview_stats -> %>
                <span class="ts-pill ts-pill--success">
                  <span class="ts-pill__dot"></span>{gettext("editor.compiled")}
                </span>
                <span :if={@preview_stats.ms} class="ts-preview__ms">{@preview_stats.ms}ms</span>
              <% true -> %>
                <span class="ts-pill">
                  <span class="ts-pill__dot"></span>{gettext("editor.status_ready")}
                </span>
            <% end %>
            <div class="ts-spacer" />
            <div id="preview-zoom" phx-hook="PreviewZoom" phx-update="ignore" class="ts-seg">
              <button type="button" data-zoom="out" aria-label={gettext("editor.zoom_out")}>
                −
              </button>
              <button type="button" data-zoom="reset" id="zoom-level">100%</button>
              <button type="button" data-zoom="in" aria-label={gettext("editor.zoom_in")}>
                +
              </button>
            </div>
            <button
              type="button"
              class="ts-btn ts-btn--ghost ts-btn--icon ts-btn--sm"
              phx-click={JS.dispatch("phx:editor-command", detail: %{cmd: "compile"})}
              aria-label={gettext("editor.refresh")}
            >
              <.icon name="hero-arrow-path" class="size-3.5" />
            </button>
            <button
              type="button"
              class="ts-btn ts-btn--ghost ts-btn--icon ts-btn--sm"
              phx-click={JS.dispatch("phx:editor-command", detail: %{cmd: "download"})}
              title={gettext("editor.download")}
              aria-label={gettext("editor.download")}
            >
              <.icon name="hero-arrow-down-tray" class="size-3.5" />
            </button>
          </div>
          <div
            id="preview-container"
            phx-hook="Preview"
            phx-update="ignore"
            class="ts-preview__scroll"
          >
            <div id="preview-placeholder" class="ts-preview__placeholder">
              <span style="color: var(--fg4);">
                <.icon name="hero-eye" class="size-8" />
              </span>
              <p>{gettext("editor.preview_placeholder")}</p>
            </div>
          </div>
        </section>

        <%!-- Status bar — spans all panes --%>
        <div class="ts-statusbar">
          <span class="ts-statusbar__item">
            <span class="ts-statusbar__dot"></span>{String.upcase(@editor_language)}
          </span>
          <span class="ts-statusbar__sep"></span>
          <span id="status-cursor" phx-update="ignore" class="ts-statusbar__item">
            Ln 1, Col 1
          </span>
          <span class="ts-statusbar__sep"></span>
          <span class="ts-statusbar__item">UTF-8</span>
          <span class="ts-statusbar__sep"></span>
          <span class="ts-statusbar__item">LF</span>
          <div class="ts-spacer" />
          <span class="ts-statusbar__item">{gettext("editor.command_hint")}</span>
        </div>
      </div>
    </div>
  </div>

  <%!-- ⌘K command palette --%>
  <div
    :if={@show_palette}
    class="ts-overlay"
    phx-click="close_palette"
    phx-window-keydown="close_palette"
    phx-key="Escape"
  >
    <div id="command-palette" phx-hook="Palette" class="ts-palette" phx-click="">
      <div class="ts-palette__input">
        <.icon name="hero-magnifying-glass" class="size-4" />
        <input
          id="palette-input"
          name="query"
          value={@palette_query}
          phx-keyup="filter_palette"
          phx-debounce="80"
          placeholder={gettext("editor.palette.placeholder")}
          autocomplete="off"
        />
        <span class="ts-kbd">ESC</span>
      </div>
      <div class="ts-palette__list">
        <div
          :if={
            palette_match?(@palette_query, gettext("editor.palette.compile")) or
              palette_match?(@palette_query, gettext("editor.palette.settings"))
          }
          class="ts-palette__group"
        >
          {gettext("editor.palette.suggested")}
        </div>
        <button
          :if={palette_match?(@palette_query, gettext("editor.palette.compile"))}
          type="button"
          class="ts-palette__item"
          phx-click={
            JS.dispatch("phx:editor-command", detail: %{cmd: "compile"})
            |> JS.push("close_palette")
          }
        >
          <.icon name="hero-play" class="size-4" />
          <span>{gettext("editor.palette.compile")}</span>
          <span class="ts-kbd ts-kbd--combo">
            <span class="ts-mac" aria-hidden="true"><i data-lucide="command"></i></span>
            <span class="ts-other">Ctrl</span>
            <i data-lucide="corner-down-left" aria-hidden="true"></i>
          </span>
        </button>
        <button
          :if={palette_match?(@palette_query, gettext("editor.palette.settings"))}
          type="button"
          class="ts-palette__item"
          phx-click={JS.navigate(~p"/users/settings")}
        >
          <.icon name="hero-cog-6-tooth" class="size-4" />
          <span>{gettext("editor.palette.settings")}</span>
        </button>

        <div :if={palette_files(@file_tree, @palette_query) != []} class="ts-palette__group">
          {gettext("editor.palette.files")}
        </div>
        <button
          :for={file <- palette_files(@file_tree, @palette_query)}
          type="button"
          class="ts-palette__item"
          phx-click={
            JS.push("select_file", value: %{"file-id" => file.id})
            |> JS.push("close_palette")
          }
        >
          <.icon name="hero-document" class="size-4" />
          <span>{file.path}</span>
        </button>

        <div
          :if={
            palette_match?(@palette_query, gettext("editor.palette.equation")) or
              palette_match?(@palette_query, gettext("editor.palette.table"))
          }
          class="ts-palette__group"
        >
          {gettext("editor.palette.insert")}
        </div>
        <button
          :if={palette_match?(@palette_query, gettext("editor.palette.equation"))}
          type="button"
          class="ts-palette__item"
          phx-click={
            JS.dispatch("phx:editor-command", detail: %{cmd: "math"})
            |> JS.push("close_palette")
          }
        >
          <.icon name="hero-variable" class="size-4" />
          <span>{gettext("editor.palette.equation")}</span>
        </button>
        <button
          :if={palette_match?(@palette_query, gettext("editor.palette.table"))}
          type="button"
          class="ts-palette__item"
          phx-click={
            JS.dispatch("phx:editor-command", detail: %{cmd: "table"})
            |> JS.push("close_palette")
          }
        >
          <.icon name="hero-table-cells" class="size-4" />
          <span>{gettext("editor.palette.table")}</span>
        </button>
      </div>
    </div>
  </div>
</Layouts.app>
